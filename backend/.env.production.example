# Porta da API exposta no host (Cloudflare Tunnel aponta pra cá)
API_PORT=6050

# Porta do Postgres exposta no host (acesso opcional via DBeaver)
DB_HOST_PORT=6051

# Porta interna que o Nest escuta dentro do container
PORT=3000

# Credenciais do Postgres
DB_USER=pallets
DB_PASSWORD=change-me
DB_NAME=pallets_db

# Segredos da aplicação — gerar com: openssl rand -hex 32
JWT_SECRET=change-me-in-production
PWD_PEPPER=change-me-in-production

# Origem(ns) permitida(s) no CORS (separadas por vírgula). Vazio = reflete qualquer origem.
CORS_ORIGIN=https://seu-dominio-frontend

# Senha do admin gerado pelo seed
SEED_ADMIN_PASSWORD=change-me
