    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.3.0",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^10.0.0",
